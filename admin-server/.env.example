# Port the admin panel server listens on
PORT=4500

# Seeds this email as the first admin on every startup (idempotent -- a
# no-op once that email already exists as an admin). Without this, a fresh
# deploy has zero admins and no way to create one: the OTP endpoint only
# issues codes to emails already in the admins table, so there's no
# self-signup bootstrap path. Set this to your own email for the first
# deploy; safe to leave set permanently.
BOOTSTRAP_ADMIN_EMAIL=

# Signs admin session cookies — MUST be set to a real random secret before
# deploying anywhere reachable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Zoho Mail SMTP (for sending OTP codes) ---
# Leave these unset to run in dev mode: OTP codes print to the server
# console instead of being emailed, so you can build/test without real
# credentials first.
#
# ZOHO_SMTP_USER is the full mailbox address to send FROM, e.g.
# otp@offshoremitra.com. ZOHO_SMTP_PASS is a Zoho app-specific password
# (Zoho requires this instead of the normal account password once
# two-factor auth is on for that mailbox) — generate one at
# https://accounts.zoho.com/home#security/app-passwords
#
# Use smtp.zoho.in or smtp.zoho.eu instead of smtp.zoho.com if the account
# is on the India or EU data center.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
OTP_FROM_NAME=Offshoremitra Admin
