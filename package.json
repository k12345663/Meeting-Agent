{
  "name": "ai-copilot",
  "version": "1.0.0",
  "description": "AI Problem Solving Assistant",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --no-sandbox --disable-gpu",
    "test-speech": "node scripts/test-speech.js",
    "fetch-whisper-model": "node scripts/download-whisper-model.js",
    "build": "npm run fetch-whisper-model && electron-builder",
    "build:mac": "npm run fetch-whisper-model && electron-builder --mac",
    "build:win": "npm run fetch-whisper-model && electron-builder --win",
    "build:linux": "npm run fetch-whisper-model && electron-builder --linux",
    "build:all": "npm run fetch-whisper-model && electron-builder --mac --win --linux",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "clean": "rm -rf dist/",
    "rebuild": "npm run clean && npm run build",
    "release": "npm run clean && npm run build:all",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": {
    "name": "Offshoremitra"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/k12345663/Meeting-Agent"
  },
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@google/genai": "^2.9.0",
    "dotenv": "^16.3.1",
    "markdown": "^0.5.0",
    "marked": "^15.0.12",
    "microsoft-cognitiveservices-speech-sdk": "^1.40.0",
    "node-record-lpcm16": "^1.0.1",
    "pdf-parse": "^2.4.5",
    "prismjs": "^1.30.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ai-copilot.app",
    "productName": "AI Copilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!*.md",
      "!.git/**/*",
      "!.env*",
      "!.venv-whisper/**/*",
      "!.whisper-models/**/*",
      "!.whisper-cpp-src/**/*",
      "!resources/whisper-cpp/**/*",
      "!bin/**/*",
      "!scripts/__pycache__/**/*",
      "!**/*.pyc",
      "!eng.traineddata",
      "!webapp/**/*"
    ],
    "asarUnpack": [
      "assests/icons/**/*",
      "prompts/**/*",
      "scripts/whisper_worker.py"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AI Copilot uses the microphone to transcribe your speech locally with Whisper.",
        "NSCameraUsageDescription": "AI Copilot does not record video; this entitlement is only present for media-capture compatibility.",
        "NSScreenCaptureUsageDescription": "AI Copilot captures the screen to read on-screen content for AI assistance."
      },
      "extraResources": [
        { "from": "resources/whisper-cpp/mac", "to": "whisper-cpp/mac" },
        { "from": "resources/whisper-cpp/models", "to": "whisper-cpp/models" }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null,
      "extraResources": [
        { "from": "resources/whisper-cpp/win", "to": "whisper-cpp/win" },
        { "from": "resources/whisper-cpp/models", "to": "whisper-cpp/models" }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assests/icons/app-icon.png",
      "category": "Utility"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xauth",
        "libasound2t64",
        "libgbm1",
        "python3 (>= 3.10)",
        "python3-venv",
        "python3-pip"
      ],
      "recommends": [
        "ffmpeg"
      ],
      "fpm": [
        "--after-install=scripts/post-install-deb.sh"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "include": "scripts/post-install-nsis.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "AI Copilot-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "AI Copilot Interview Assistant",
      "backgroundColor": "#000000",
      "window": {
        "width": 600,
        "height": 400
      }
    }
  }
}
